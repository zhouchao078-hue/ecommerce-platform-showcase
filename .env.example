# ============================================================
# 电商项目环境变量示例
# 复制为项目根目录 .env 后填写真实值。.env 不会提交到 Git。
# ============================================================

# 服务端口与 Gateway 路由
GATEWAY_PORT=8080
COMMERCE_SERVICE_PORT=8081
AGENT_SERVICE_PORT=8082
COMMERCE_SERVICE_URI=http://127.0.0.1:8081
AGENT_SERVICE_URI=http://127.0.0.1:8082

# Spring Boot 直接按 properties 语法读取这些键
agent.env=prod

# MySQL
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/ecommerce?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change-me

# Redis
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=change-me
REDIS_PASSWORD=change-me

# Kafka
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=ecommerce

agent.supervisor.model=deepseek-chat
agent.supervisor.api-key=your-deepseek-api-key
agent.supervisor.endpoint=https://api.deepseek.com/v1/chat/completions

agent.commerce.model=gpt-4o
agent.commerce.api-key=your-openai-api-key
agent.commerce.endpoint=https://api.openai.com/v1/chat/completions

agent.local.model=llama3.2
agent.local.endpoint=http://localhost:11434/api/chat
AGENT_LOCAL_ENDPOINT=http://localhost:11434/api/chat
AGENT_TICKET_BASE_URL=http://127.0.0.1:8000

AGENT_GLOBAL_CONCURRENCY=32
AGENT_PER_USER_CONCURRENCY=2
AGENT_CHAT_QUEUE_CAPACITY=100
AGENT_CHAT_TIMEOUT_SECONDS=120
AGENT_LLM_CONCURRENCY=8
AGENT_LLM_ACQUIRE_TIMEOUT_MILLIS=1000
AGENT_LLM_TIMEOUT_SECONDS=60
AGENT_LLM_CIRCUIT_FAILURE_RATE=50
AGENT_LLM_CIRCUIT_WINDOW_SIZE=20
AGENT_LLM_CIRCUIT_MINIMUM_CALLS=10
AGENT_LLM_CIRCUIT_OPEN_SECONDS=30
AGENT_LLM_CIRCUIT_HALF_OPEN_CALLS=3
AGENT_SESSION_HISTORY_LIMIT=20
AGENT_SESSION_TTL_SECONDS=3600
AGENT_SSE_SCHEDULER_POOL_SIZE=4
AGENT_SSE_HEARTBEAT_MILLIS=15000
AGENT_SSE_TIMEOUT_SECONDS=1800

DB_MAX_POOL_SIZE=20
DB_MIN_IDLE=5
DB_CONNECTION_TIMEOUT_MS=3000
REDIS_MAX_ACTIVE=16
REDIS_MAX_IDLE=8
REDIS_MIN_IDLE=2
TOMCAT_MAX_THREADS=200
TOMCAT_MIN_SPARE_THREADS=20
TOMCAT_ACCEPT_COUNT=100
TOMCAT_MAX_CONNECTIONS=8192

# 工单 Agent 分发：local 或 rabbit
AGENT_TICKET_DISPATCH_MODE=local
AGENT_TICKET_ACTIVE_RUN_TTL_SECONDS=86400
AGENT_TICKET_MAX_ACTIVE_RUNS_PER_USER=3
AGENT_TICKET_OUTBOX_LEASE_SECONDS=60
AGENT_TICKET_MODEL=deepseek-chat
AGENT_TICKET_PROMPT_VERSION=support-agent-v1
INTERNAL_API_TOKEN=change-me
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=change-me
RABBITMQ_PASSWORD=change-me

# Alertmanager: generic webhook override. Leave empty to use the built-in
# Feishu relay when FEISHU_BOT_WEBHOOK_URL is configured.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SEND_RESOLVED=true

# Feishu custom bot. The relay signs requests when a secret is configured.
FEISHU_BOT_WEBHOOK_URL=
FEISHU_BOT_SECRET=
FEISHU_BOT_MENTION_USER_IDS=
FEISHU_BOT_MENTION_ALL=false
RABBIT_RUN_ROUTING_KEY=agent.run.normal
RABBIT_CANCEL_ROUTING_KEY=agent.cancel
AGENT_TICKET_LEASE_RECOVERY_INTERVAL_MS=15000
AGENT_TICKET_LEASE_RECOVERY_BATCH_SIZE=20
AGENT_TICKET_KAFKA_ENABLED=false
KAFKA_RUN_TOPIC=support.agent.run.events.v1

# 前端 Vite 读取：统一经过 Gateway
VITE_API_PROXY_TARGET=http://localhost:8080
