# Select an LLM supported by your CrewAI installation.
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini

# Set to true to avoid sending customer data to a remote model in production.
DRY_RUN=true

# Shared with the Java platform internal callback and HTTP calls.
INTERNAL_API_TOKEN=change-me
TICKET_AGENT_MAX_CONCURRENT_REQUESTS=4
